{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forty-classic-books",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/forty-classic-books/*",
      "zone_name": "xiaosang.cc"
    },
    {
      "pattern": "xiaosang.cc/forty-classic-books",
      "zone_name": "xiaosang.cc"
    }
  ]
}